<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows installer definition, built with WiX 5 and its UI extension.
  `python tools/build_app.py` with the msi flag does the whole thing: engine,
  front end, installer.

  It installs the WinUI 3 application: the native Windows window with the
  Python engine folded into it. There is nothing else to install afterwards.

  Two things here are load-bearing, and both were learned the hard way.

  A UI, because there did not use to be one. Without it an MSI shows
  "gathering required information", installs, and closes without a word, so a
  successful install is indistinguishable from a failed one and everybody who
  ran it reasonably concluded it was broken. Now: welcome, install location,
  progress, done, and an offer to start the program.

  No double dash anywhere in these comments. XML forbids it inside a comment,
  and naming a command line flag in prose is enough for WiX to refuse the file
  with error WIX0104.

  The UpgradeCode must never change: it is what tells Windows that a new MSI
  replaces the installed MThread Draw rather than sitting beside it. It is
  derived from the project URL (uuid5 of
  https://github.com/MAXAWER/MThread-Draw) so it can be regenerated if lost.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
      Name="MThread Draw"
      Manufacturer="Maxim Averyanov"
      Version="$(var.Version)"
      UpgradeCode="370FFAF1-4E6F-55E8-A367-BC1F6BCB5CE5"
      Scope="perMachine"
      Compressed="yes">

    <SummaryInformation Description="Draw images on an Android screen over ADB" />

    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of MThread Draw is already installed. Remove it first from Settings, Installed apps." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="MThreadDrawIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="MThreadDrawIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/MAXAWER/MThread-Draw" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/MAXAWER/MThread-Draw" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="MThread Draw" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="MThread Draw" />
    </StandardDirectory>

    <Feature Id="Main" Title="MThread Draw" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentGroupRef Id="ApplicationShortcuts" />
    </Feature>

    <!--
      Welcome, where to put it, progress, finished. WixUI_InstallDir normally
      puts a licence agreement between the first two; the two Publish overrides
      below step past it. AGPL-3.0 grants permission rather than withholding it,
      so there is nothing for anyone to agree to before installing, and a dialog
      that says otherwise would be theatre. The licence travels in the install
      folder and is linked from the finish dialog instead.
    -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog"
               Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog"
               Value="WelcomeDlg" Order="2" Condition="NOT Installed" />
    </UI>

    <!-- Apps & features shows the folder rather than a blank line. -->
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" />

    <!--
      The finish dialog offers to start it. Impersonate="yes" matters: the
      installer is elevated and the program must not be, or it would run as
      administrator and its file dialogs would look at the wrong desktop.
    -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Start MThread Draw" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <!--
      By path rather than by file id: the harvest below generates ids nothing
      here can predict. A plain exe action rather than the utility extension's
      shell helper, which needs a reference to a binary inside the extension
      that only the extension knows the name of.

      asyncNoWait so the installer finishes instead of waiting for the program
      to be closed again.
    -->
    <CustomAction Id="StartApplication" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]MThreadDraw.exe&quot;"
                  Impersonate="yes" Return="asyncNoWait" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction"
               Value="StartApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
  </Package>

  <Fragment>
    <!--
      Harvested at build time. The published front end is several thousand
      files - the .NET runtime, the Windows App SDK and the packaged engine -
      and listing them by hand would be a maintenance trap.
    -->
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.SourceDir)\**" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ApplicationShortcuts">
      <Component Id="StartMenuShortcut" Directory="AppMenuFolder"
                 Guid="67F33680-4C6F-56E7-BA76-31FA619E8736">
        <Shortcut Id="MThreadDrawStartMenu"
                  Name="MThread Draw"
                  Description="Draw images on an Android screen over ADB"
                  Target="[INSTALLFOLDER]MThreadDraw.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="MThreadDrawIcon" />
        <RemoveFolder Id="RemoveAppMenuFolder" Directory="AppMenuFolder" On="uninstall" />
        <RegistryValue Root="HKMU" Key="Software\MThreadDraw" Name="installed"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

</Wix>
