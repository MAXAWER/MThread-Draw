<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows installer definition, built with WiX 5:

      wix build packaging/MThreadDraw.wxs -arch x64 ^
          -d Version=1.1.0 -d SourceDir=dist/MThreadDraw -d IconFile=packaging/mthreaddraw.ico ^
          -o dist/MThreadDraw-1.1.0-x64.msi

  `tools/build_app.py` with the msi flag does exactly that after PyInstaller
  has run.

  The UpgradeCode must never change: it is what tells Windows that a new MSI
  replaces the installed MThreadDraw rather than sitting beside it. It is derived
  from the project URL (uuid5 of https://github.com/MAXAWER/MThread-Draw) so it
  can be regenerated if it is ever lost.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
      Name="MThread Draw"
      Manufacturer="Maxim Averyanov"
      Version="$(var.Version)"
      UpgradeCode="370FFAF1-4E6F-55E8-A367-BC1F6BCB5CE5"
      Scope="perMachine"
      Compressed="yes">

    <SummaryInformation Description="Draw images on an Android screen over ADB" />

    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of MThread Draw is already installed. Remove it first from Settings, Installed apps." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="MThreadDrawIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="MThreadDrawIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/MAXAWER/MThread-Draw" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/MAXAWER/MThread-Draw" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="MThread Draw" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="MThread Draw" />
    </StandardDirectory>

    <Feature Id="Main" Title="MThread Draw" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentGroupRef Id="ApplicationShortcuts" />
    </Feature>

    <!-- Offer to start the app when the installer finishes. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Start MThread Draw" />
  </Package>

  <Fragment>
    <!-- Harvested at build time: PyInstaller's output is a few hundred files
         and listing them by hand would be a maintenance trap. -->
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.SourceDir)\**" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ApplicationShortcuts">
      <Component Id="StartMenuShortcut" Directory="AppMenuFolder"
                 Guid="67F33680-4C6F-56E7-BA76-31FA619E8736">
        <Shortcut Id="MThreadDrawStartMenu"
                  Name="MThread Draw"
                  Description="Draw images on an Android screen over ADB"
                  Target="[INSTALLFOLDER]MThreadDraw.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="MThreadDrawIcon" />
        <RemoveFolder Id="RemoveAppMenuFolder" Directory="AppMenuFolder" On="uninstall" />
        <RegistryValue Root="HKMU" Key="Software\MThreadDraw" Name="installed"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

</Wix>
