<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AutoDraw.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AutoDraw">

    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="340,*">

        <!-- Device bar, across the top: nothing else can be done until this is settled. -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Padding="16,12"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="AutoDraw" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ComboBox x:Name="DeviceBox" MinWidth="220" PlaceholderText="No device found"
                          VerticalAlignment="Center"/>
                <Button x:Name="RefreshButton" Content="Refresh" Click="OnRefreshDevices"/>
                <Button x:Name="ConnectButton" Content="Connect" Style="{StaticResource AccentButtonStyle}"
                        Click="OnConnect"/>
                <TextBlock x:Name="DeviceText" VerticalAlignment="Center" Opacity="0.75"
                           Text="Not connected"/>
            </StackPanel>
        </Border>

        <!-- Controls -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" Padding="16,16,8,16">
            <StackPanel Spacing="6">

                <Button x:Name="LoadButton" Content="Load image…" HorizontalAlignment="Stretch"
                        Click="OnLoadImage"/>
                <TextBlock x:Name="ImageText" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="No image loaded"/>

                <TextBlock Text="What is in the picture" FontWeight="SemiBold"/>
                <ComboBox x:Name="TracerBox" HorizontalAlignment="Stretch"
                          SelectionChanged="OnSettingChanged">
                    <ComboBoxItem Content="Buildings, machines, objects" IsSelected="True" Tag="canny"/>
                    <ComboBoxItem Content="Portraits, animals, nature" Tag="flow"/>
                </ComboBox>
                <TextBlock Text="Two ways of finding lines. The first keeps every edge it can see; the second follows the direction lines run in."
                           TextWrapping="Wrap" Opacity="0.6" FontSize="12" Margin="0,2,0,10"/>

                <TextBlock Text="Edge sensitivity"/>
                <Slider x:Name="SensitivitySlider" Minimum="1" Maximum="10" Value="5" StepFrequency="1"
                        ValueChanged="OnSliderChanged"/>

                <TextBlock Text="Detail"/>
                <Slider x:Name="DetailSlider" Minimum="1" Maximum="10" Value="7" StepFrequency="1"
                        ValueChanged="OnSliderChanged"/>

                <TextBlock Text="Margin around the drawing"/>
                <Slider x:Name="MarginSlider" Minimum="0" Maximum="30" Value="6" StepFrequency="1"/>

                <TextBlock Text="Speed" Margin="0,10,0,0"/>
                <Slider x:Name="SpeedSlider" Minimum="-2" Maximum="2" Value="0" StepFrequency="0.25"
                        ValueChanged="OnPacingChanged"/>
                <TextBlock x:Name="SpeedText" Opacity="0.7" FontSize="12" Text="1.00x"/>

                <TextBlock Text="Draw like a hand" Margin="0,8,0,0"/>
                <Slider x:Name="HandSlider" Minimum="0" Maximum="3" Value="0" StepFrequency="0.25"
                        ValueChanged="OnPacingChanged"/>
                <TextBlock x:Name="HandText" Opacity="0.7" FontSize="12" Text="off"/>

                <TextBlock x:Name="EstimateText" TextWrapping="Wrap" Margin="0,12,0,0" Opacity="0.8"/>

                <Button x:Name="DrawButton" Content="START DRAWING" HorizontalAlignment="Stretch"
                        Height="44" Margin="0,12,0,0" Style="{StaticResource AccentButtonStyle}"
                        Click="OnDraw" IsEnabled="False"/>
                <Button x:Name="StopButton" Content="Stop" HorizontalAlignment="Stretch"
                        Click="OnStop" IsEnabled="False"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Preview -->
        <Border Grid.Row="1" Grid.Column="1" Margin="8,16,16,16" CornerRadius="8"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <TextBlock x:Name="PreviewHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Opacity="0.5" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"
                           Text="Load an image to see the strokes that will be drawn."/>
                <Image x:Name="PreviewImage" Margin="12" Stretch="Uniform"/>
                <ProgressRing x:Name="Busy" IsActive="False" Width="42" Height="42"/>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Padding="16,10"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,220">
                <TextBlock x:Name="StatusText" Text="Starting the engine…" VerticalAlignment="Center"/>
                <ProgressBar x:Name="Progress" Grid.Column="1" VerticalAlignment="Center" Value="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
