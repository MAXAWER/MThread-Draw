<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MThreadDraw.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="MThread Draw">

    <!--
        The content is capped and centred. Stretched across a wide window the
        controls stay pinned left while the phone drifts to the middle of
        whatever is left, and the gap between them grows into a hole.
    -->
    <Grid RowDefinitions="44,Auto,*,Auto" ColumnDefinitions="340,*"
          MaxWidth="1100" HorizontalAlignment="Center">

        <!--
            The title bar is ours, not the system's.

            Left as it came, the window carried two copies of its own name: one
            in the system caption and one in the toolbar underneath it, with a
            grey strip between them doing nothing. Extending the content into
            the caption removes the strip; the name then only needs saying once,
            next to the same mark the icon uses.
        -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Grid.ColumnSpan="2" Padding="14,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="6" Background="#11121A">
                    <Ellipse Width="13" Height="13" Fill="White"/>
                </Border>
                <TextBlock Text="MThread Draw" FontSize="13" VerticalAlignment="Center" Opacity="0.85"/>
            </StackPanel>
        </Grid>

        <!-- Device bar: nothing else can be done until this is settled. -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="16,12"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,1">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ComboBox x:Name="DeviceBox" MinWidth="260" PlaceholderText="Looking for a device…"
                          VerticalAlignment="Center"/>
                <Button x:Name="RefreshButton" Content="Refresh" Click="OnRefreshDevices"/>
                <Button x:Name="ConnectButton" Content="Connect" Style="{StaticResource AccentButtonStyle}"
                        Click="OnConnect"/>
                <TextBlock x:Name="DeviceText" VerticalAlignment="Center" Opacity="0.75"
                           Text="Not connected"/>
            </StackPanel>
        </Border>

        <!-- Controls -->
        <ScrollViewer Grid.Row="2" Grid.Column="0" Padding="16,16,8,16">
            <StackPanel Spacing="6">

                <Button x:Name="LoadButton" Content="Load image…" HorizontalAlignment="Stretch"
                        Click="OnLoadImage"/>
                <TextBlock x:Name="ImageText" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="No image loaded"/>

                <!--
                    Layers. Several pictures arranged against each other before
                    anything is drawn, each with its own placement and its own
                    tracer settings.
                -->
                <ListView x:Name="LayerList" MaxHeight="130" Margin="0,0,0,6"
                          SelectionMode="Single" SelectionChanged="OnLayerSelected"
                          Background="{ThemeResource LayerFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1" CornerRadius="6"/>
                <Grid ColumnDefinitions="*,6,*,6,*" Margin="0,0,0,12">
                    <Button x:Name="LayerRaiseButton" Content="Bring forward" FontSize="12"
                            HorizontalAlignment="Stretch" Click="OnLayerRaise" IsEnabled="False"/>
                    <Button x:Name="LayerHideButton" Grid.Column="2" Content="Hide" FontSize="12"
                            HorizontalAlignment="Stretch" Click="OnLayerHide" IsEnabled="False"/>
                    <Button x:Name="LayerRemoveButton" Grid.Column="4" Content="Remove" FontSize="12"
                            HorizontalAlignment="Stretch" Click="OnLayerRemove" IsEnabled="False"/>
                </Grid>

                <TextBlock Text="What is in the picture" FontWeight="SemiBold"/>
                <ComboBox x:Name="TracerBox" HorizontalAlignment="Stretch"
                          SelectionChanged="OnSettingChanged">
                    <ComboBoxItem Content="Buildings, machines, objects" IsSelected="True" Tag="canny"/>
                    <ComboBoxItem Content="Portraits, animals, nature" Tag="flow"/>
                </ComboBox>
                <TextBlock Text="Two ways of finding lines. The first keeps every edge it can see; the second follows the direction lines run in."
                           TextWrapping="Wrap" Opacity="0.6" FontSize="12" Margin="0,2,0,14"/>

                <!--
                    Two sliders, not five.

                    Edge sensitivity and detail were always turned together and
                    nobody could say what the difference was, so they are one
                    control now. Speed and hand simulation were one axis
                    pretending to be two: nobody wants a hand that draws
                    instantly or a robot that trembles.
                -->
                <TextBlock Text="How much detail"/>
                <Slider x:Name="DetailSlider" Minimum="1" Maximum="10" Value="7" StepFrequency="1"
                        ValueChanged="OnSliderChanged"/>
                <TextBlock x:Name="DetailText" Opacity="0.7" FontSize="12" Text="7 — a fair amount"/>

                <TextBlock Text="How it draws" Margin="0,14,0,0"/>
                <Slider x:Name="FeelSlider" Minimum="0" Maximum="10" Value="0" StepFrequency="1"
                        ValueChanged="OnPacingChanged"/>
                <TextBlock x:Name="FeelText" Opacity="0.7" FontSize="12" Text="instantly"/>

                <TextBlock x:Name="EstimateText" TextWrapping="Wrap" Margin="0,14,0,0" Opacity="0.8"/>

                <Button x:Name="DrawButton" Content="START DRAWING" HorizontalAlignment="Stretch"
                        Height="44" Margin="0,12,0,0" Style="{StaticResource AccentButtonStyle}"
                        Click="OnDraw" IsEnabled="False"/>
                <Button x:Name="StopButton" Content="Stop" HorizontalAlignment="Stretch"
                        Click="OnStop" IsEnabled="False"/>

                <!--
                    Recording, which is the other half of what this does. The
                    file it writes holds fractions of a screen rather than
                    digitizer coordinates, so it replays on a different phone.
                -->
                <TextBlock Text="Record and replay" FontWeight="SemiBold" Margin="0,26,0,6"/>
                <TextBlock x:Name="SessionText" Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                           Text="Nothing recorded yet."/>
                <Grid ColumnDefinitions="*,8,*" Margin="0,8,0,0">
                    <Button x:Name="RecordButton" Content="Record" HorizontalAlignment="Stretch"
                            Click="OnRecord"/>
                    <Button x:Name="PlayButton" Grid.Column="2" Content="Play"
                            HorizontalAlignment="Stretch" Click="OnPlay" IsEnabled="False"/>
                </Grid>
                <Grid ColumnDefinitions="*,8,*" Margin="0,8,0,0">
                    <Button x:Name="OpenSessionButton" Content="Open…" HorizontalAlignment="Stretch"
                            Click="OnOpenSession"/>
                    <Button x:Name="SaveSessionButton" Grid.Column="2" Content="Save…"
                            HorizontalAlignment="Stretch" Click="OnSaveSession" IsEnabled="False"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!--
            The phone itself: its shape, its screen, and the drawing lying on
            top of where it is going to go.

            The frame is sized in code to the device's own resolution and the
            Viewbox scales it to whatever room there is, so the proportions are
            the phone's rather than a guess. Stretch is Fill inside because the
            frame already has the right aspect ratio.
        -->
        <Grid Grid.Row="2" Grid.Column="1" Margin="8,16,16,16" RowDefinitions="*,Auto,Auto"
              x:Name="PhoneStage" Background="Transparent"
              PointerPressed="OnStagePressed" PointerMoved="OnStageMoved"
              PointerReleased="OnStageReleased" PointerCanceled="OnStageReleased"
              PointerWheelChanged="OnStageWheel" DoubleTapped="OnStageDoubleTapped">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                <Border x:Name="PhoneFrame" Width="336" Height="748" CornerRadius="30"
                        Background="#0E0F13" Padding="9">
                    <Grid x:Name="PhoneScreen" CornerRadius="22" Background="#1B1D24">
                        <Image x:Name="MirrorImage" Stretch="Fill"/>
                        <Image x:Name="OverlayImage" Stretch="Fill" Opacity="0.95"/>
                    </Grid>
                </Border>
            </Viewbox>

            <TextBlock x:Name="PreviewHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"
                       Text="Connect a device to see its screen here."/>
            <ProgressRing x:Name="Busy" IsActive="False" Width="42" Height="42"
                          VerticalAlignment="Top" HorizontalAlignment="Right" Margin="12"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,10,0,0"
                        HorizontalAlignment="Center">
                <ToggleButton x:Name="MoveToggle" Content="Move" IsChecked="True" FontSize="12"
                              Click="OnToolChanged"/>
                <ToggleButton x:Name="EraseToggle" Content="Erase" FontSize="12"
                              Click="OnToolChanged"/>
                <Button x:Name="UndoEraseButton" Content="Undo erase" FontSize="12"
                        Click="OnUndoErase"/>
                <Button x:Name="FlipXButton" Content="Flip ↔" FontSize="12" Click="OnFlipX"/>
                <Button x:Name="FlipYButton" Content="Flip ↕" FontSize="12" Click="OnFlipY"/>
                <Button x:Name="FitButton" Content="Fit" FontSize="12" Click="OnFit"/>
                <Button x:Name="StillButton" Content="Use a screenshot…" FontSize="12"
                        Click="OnUseStill"/>
            </StackPanel>

            <TextBlock x:Name="PlaceHint" Grid.Row="2" Margin="0,8,0,0" FontSize="12"
                       HorizontalAlignment="Center" Opacity="0.55"
                       Text="Drag to move it · wheel to resize · Shift and wheel to turn · double-click to fit"/>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Grid.ColumnSpan="2" Padding="16,10"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,220">
                <TextBlock x:Name="StatusText" Text="Starting the engine…" VerticalAlignment="Center"/>
                <ProgressBar x:Name="Progress" Grid.Column="1" VerticalAlignment="Center" Value="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
